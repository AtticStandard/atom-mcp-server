{
  "name": "atom-mcp-server",
  "mcpName": "io.github.AtticStandard/atom-mcp-server",
  "version": "2.1.0",
  "description": "Attic Standard: the global price benchmark for AI inference, for agents. 23 price indexes, 9 market KPIs and SKU-level prices across 58 vendors, in 11 MCP tools.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "atom-mcp-server": "./dist/index.js"
  },
  "homepage": "https://atticstandard.com/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtticStandard/atom-mcp-server"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "start:http": "TRANSPORT=http node dist/index.js",
    "start:stdio": "TRANSPORT=stdio node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "inference",
    "pricing",
    "price-index",
    "benchmark",
    "llm",
    "ai-pricing",
    "inference-pricing",
    "finops",
    "attic-standard"
  ],
  "author": "Attic Standard (Member One EOOD)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "express": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
